{
    "name": "eznix86/laravel-sqlite",
    "description": "Optimize SQLite for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Eznix86\\LaravelSQLite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eznix86\\LaravelSQLite\\AppServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Bruno Bernard",
            "email": "contact.brunobernard@gmail.com"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.9",
        "rector/rector": "^2.3.7",
        "mrpunyapal/rector-pest": "^0.2.0",
        "driftingly/rector-laravel": "^2.1.9"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:types": "vendor/bin/phpstan analyse --memory-limit=1G",
        "refactor": "vendor/bin/rector process",
        "test:refactor": "vendor/bin/rector process --dry-run",
        "lint": [
            "@test:refactor",
            "vendor/bin/pint --test --parallel"
        ],
        "lint:fix": [
            "@refactor",
            "vendor/bin/pint --parallel"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    }
}
